<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rubu Script - Zombie Rush Survival</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --blood: #c0392b;
    --blood-dark: #7b241c;
    --neon-green: #39ff14;
    --neon-red: #ff2244;
    --dark: #0a0a0f;
    --panel: rgba(10,10,20,0.92);
    --border: rgba(192,57,43,0.5);
    --text: #e8e8e8;
    --muted: #888;
    --active: #39ff14;
    --inactive: #444;
    --toggle-on: #39ff14;
    --toggle-off: #333;
    --glow-green: 0 0 8px #39ff14, 0 0 20px rgba(57,255,20,0.3);
    --glow-red: 0 0 8px #ff2244, 0 0 20px rgba(255,34,68,0.3);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0a0a0f;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Rajdhani', sans-serif;
    overflow: hidden;
    position: relative;
  }

  /* Animated background */
  .bg {
    position: fixed; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(192,57,43,0.12) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(57,255,20,0.06) 0%, transparent 50%),
      #0a0a0f;
  }

  .bg-grid {
    position: fixed; inset: 0; z-index: 0;
    background-image:
      linear-gradient(rgba(192,57,43,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(192,57,43,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    animation: gridScroll 20s linear infinite;
  }

  @keyframes gridScroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(40px); }
  }

  /* Particles */
  .particle {
    position: fixed;
    width: 2px; height: 2px;
    background: var(--neon-green);
    border-radius: 50%;
    animation: floatUp linear infinite;
    opacity: 0;
  }

  @keyframes floatUp {
    0% { transform: translateY(100vh) translateX(0); opacity: 0; }
    10% { opacity: 0.6; }
    90% { opacity: 0.3; }
    100% { transform: translateY(-10vh) translateX(30px); opacity: 0; }
  }

  /* Main UI Panel */
  .ui-wrapper {
    position: relative; z-index: 10;
    animation: panelIn 0.5s cubic-bezier(0.16,1,0.3,1) forwards;
  }

  @keyframes panelIn {
    from { opacity: 0; transform: scale(0.88) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .ui-panel {
    width: 340px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(192,57,43,0.15),
      0 20px 60px rgba(0,0,0,0.8),
      inset 0 1px 0 rgba(255,255,255,0.03);
    position: relative;
  }

  /* Corner decorations */
  .ui-panel::before, .ui-panel::after {
    content: '';
    position: absolute;
    width: 12px; height: 12px;
    border-color: var(--blood);
    border-style: solid;
    z-index: 20;
  }
  .ui-panel::before { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  .ui-panel::after { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }

  /* Header */
  .header {
    background: linear-gradient(135deg, #1a0505 0%, #0f0f1a 50%, #051a05 100%);
    padding: 16px 18px 12px;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .header::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--blood), var(--neon-green), transparent);
    animation: scanLine 3s ease-in-out infinite;
  }

  @keyframes scanLine {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .header-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .logo-icon {
    width: 32px; height: 32px;
    background: linear-gradient(135deg, var(--blood), #e74c3c);
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    box-shadow: var(--glow-red);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  .logo-icon::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
  }

  .header-title {
    flex: 1;
  }

  .title-main {
    font-family: 'Orbitron', monospace;
    font-size: 15px;
    font-weight: 900;
    color: #fff;
    letter-spacing: 1px;
    text-shadow: var(--glow-red);
    line-height: 1;
  }

  .title-sub {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 3px;
  }

  .header-controls {
    display: flex; gap: 5px;
  }

  .ctrl-btn {
    width: 18px; height: 18px;
    border-radius: 2px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.05);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; color: var(--muted);
    transition: all 0.2s;
  }
  .ctrl-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .ctrl-btn.close:hover { background: var(--blood); border-color: var(--blood); color: #fff; }

  .game-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(57,255,20,0.08);
    border: 1px solid rgba(57,255,20,0.2);
    border-radius: 2px;
    padding: 3px 8px;
    font-size: 10px;
    color: var(--neon-green);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .game-badge::before {
    content: '';
    width: 5px; height: 5px;
    background: var(--neon-green);
    border-radius: 50%;
    box-shadow: var(--glow-green);
    animation: blink 1.5s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Tab Navigation */
  .tabs {
    display: flex;
    background: rgba(0,0,0,0.4);
    border-bottom: 1px solid rgba(192,57,43,0.2);
  }

  .tab {
    flex: 1;
    padding: 9px 5px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    border: none;
    background: none;
  }

  .tab.active {
    color: var(--neon-green);
    text-shadow: var(--glow-green);
  }

  .tab.active::after {
    content: '';
    position: absolute;
    bottom: 0; left: 10%; right: 10%;
    height: 2px;
    background: var(--neon-green);
    box-shadow: var(--glow-green);
    border-radius: 1px;
  }

  .tab:hover:not(.active) { color: #ccc; }

  /* Content */
  .content {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Section Label */
  .section-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--blood);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--blood-dark), transparent);
  }

  /* Feature Row */
  .feature-row {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 3px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.2s;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .feature-row::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--inactive);
    transition: all 0.3s;
  }

  .feature-row.on::before {
    background: var(--neon-green);
    box-shadow: var(--glow-green);
  }

  .feature-row.on {
    background: rgba(57,255,20,0.04);
    border-color: rgba(57,255,20,0.15);
  }

  .feature-row:hover {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.1);
  }

  .feat-icon {
    width: 32px; height: 32px;
    border-radius: 3px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
    transition: all 0.3s;
  }

  .feature-row.on .feat-icon {
    background: rgba(57,255,20,0.1);
    border-color: rgba(57,255,20,0.3);
  }

  .feat-info { flex: 1; min-width: 0; }

  .feat-name {
    font-family: 'Orbitron', monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.5px;
    transition: color 0.3s;
  }

  .feature-row.on .feat-name {
    color: var(--neon-green);
    text-shadow: 0 0 8px rgba(57,255,20,0.5);
  }

  .feat-desc {
    font-size: 10px;
    color: var(--muted);
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Toggle Switch */
  .toggle {
    width: 38px; height: 20px;
    background: var(--toggle-off);
    border-radius: 10px;
    position: relative;
    flex-shrink: 0;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.08);
    transition: all 0.3s;
  }

  .toggle.on {
    background: rgba(57,255,20,0.2);
    border-color: var(--neon-green);
    box-shadow: 0 0 10px rgba(57,255,20,0.3);
  }

  .toggle-knob {
    position: absolute;
    width: 14px; height: 14px;
    background: #555;
    border-radius: 50%;
    top: 2px; left: 2px;
    transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }

  .toggle.on .toggle-knob {
    left: 20px;
    background: var(--neon-green);
    box-shadow: var(--glow-green);
  }

  /* Status Tag */
  .status-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .status-tag.off {
    background: rgba(255,255,255,0.05);
    color: var(--muted);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .status-tag.active {
    background: rgba(57,255,20,0.15);
    color: var(--neon-green);
    border: 1px solid rgba(57,255,20,0.3);
    text-shadow: var(--glow-green);
  }

  .status-tag.warn {
    background: rgba(255,165,0,0.12);
    color: #ffa500;
    border: 1px solid rgba(255,165,0,0.3);
  }

  /* Speed Slider */
  .slider-row {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 3px;
    padding: 10px 12px;
    border-left: 2px solid var(--blood);
  }

  .slider-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .slider-label {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    display: flex; align-items: center; gap: 6px;
  }

  .slider-val {
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 900;
    color: var(--neon-green);
    text-shadow: var(--glow-green);
  }

  .slider {
    -webkit-appearance: none;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--neon-green) 50%, #222 50%);
    outline: none;
    cursor: pointer;
  }

  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: var(--glow-green);
    cursor: pointer;
    transition: transform 0.1s;
  }

  .slider::-webkit-slider-thumb:hover { transform: scale(1.3); }

  /* Footer */
  .footer {
    padding: 10px 16px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0,0,0,0.3);
  }

  .footer-info {
    font-size: 9px;
    color: #444;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .footer-info span { color: var(--blood); }

  .inject-btn {
    background: linear-gradient(135deg, var(--blood-dark), var(--blood));
    border: 1px solid var(--blood);
    color: #fff;
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 6px 14px;
    border-radius: 2px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.2s;
    box-shadow: 0 0 15px rgba(192,57,43,0.3);
  }

  .inject-btn:hover {
    box-shadow: 0 0 25px rgba(192,57,43,0.6);
    transform: translateY(-1px);
  }

  /* Notification */
  .notif {
    position: fixed;
    top: 20px; right: 20px;
    background: rgba(10,10,20,0.95);
    border: 1px solid var(--neon-green);
    border-left: 3px solid var(--neon-green);
    box-shadow: var(--glow-green);
    padding: 10px 14px;
    border-radius: 3px;
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    color: var(--neon-green);
    z-index: 100;
    transform: translateX(120%);
    transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
    letter-spacing: 0.5px;
  }

  .notif.show { transform: translateX(0); }
</style>
</head>
<body>

<div class="bg"></div>
<div class="bg-grid"></div>

<!-- Particles -->
<script>
  for (let i = 0; i < 15; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    p.style.left = Math.random() * 100 + 'vw';
    p.style.animationDuration = (8 + Math.random() * 12) + 's';
    p.style.animationDelay = (Math.random() * 10) + 's';
    p.style.width = p.style.height = (1 + Math.random() * 2) + 'px';
    document.body.appendChild(p);
  }
</script>

<div class="notif" id="notif">✓ FEATURE TOGGLED</div>

<div class="ui-wrapper">
  <div class="ui-panel">

    <!-- Header -->
    <div class="header">
      <div class="header-top">
        <div class="logo-icon">☣️</div>
        <div class="header-title">
          <div class="title-main">RUBU SCRIPT</div>
          <div class="title-sub">Zombie Rush Survival</div>
        </div>
        <div class="header-controls">
          <div class="ctrl-btn">—</div>
          <div class="ctrl-btn close">✕</div>
        </div>
      </div>
      <div class="game-badge">GAME ĐANG HOẠT ĐỘNG</div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" onclick="switchTab(this, 'combat')">⚔ Combat</button>
      <button class="tab" onclick="switchTab(this, 'move')">🏃 Move</button>
      <button class="tab" onclick="switchTab(this, 'misc')">⚙ Misc</button>
    </div>

    <!-- COMBAT TAB -->
    <div class="content" id="tab-combat">
      <div class="section-label">Tấn Công</div>

      <div class="feature-row" onclick="toggleFeature(this, 'Kill Aura đã BẬT')">
        <div class="feat-icon">⚡</div>
        <div class="feat-info">
          <div class="feat-name">Kill Aura</div>
          <div class="feat-desc">Tự động tấn công zombie trong bán kính</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>

      <div class="slider-row">
        <div class="slider-header">
          <div class="slider-label">📏 Bán kính</div>
          <div class="slider-val" id="radius-val">15</div>
        </div>
        <input type="range" class="slider" id="radius-slider" min="5" max="50" value="15"
          oninput="updateSlider(this, 'radius-val')">
      </div>

      <div class="section-label">Pertahanan</div>

      <div class="feature-row" onclick="toggleFeature(this, 'GodMode đã BẬT')">
        <div class="feat-icon">🛡️</div>
        <div class="feat-info">
          <div class="feat-name">God Mode</div>
          <div class="feat-desc">Bất tử — không nhận sát thương</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>
    </div>

    <!-- MOVEMENT TAB -->
    <div class="content" id="tab-move" style="display:none">
      <div class="section-label">Di Chuyển</div>

      <div class="feature-row" onclick="toggleFeature(this, 'No Clip đã BẬT')">
        <div class="feat-icon">👻</div>
        <div class="feat-info">
          <div class="feat-name">No Clip</div>
          <div class="feat-desc">Đi xuyên tường và vật thể</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>

      <div class="feature-row" onclick="toggleFeature(this, 'Bay đã BẬT')">
        <div class="feat-icon">🦅</div>
        <div class="feat-info">
          <div class="feat-name">Fly</div>
          <div class="feat-desc">Bay tự do trong map</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>

      <div class="slider-row">
        <div class="slider-header">
          <div class="slider-label">💨 Tốc độ bay</div>
          <div class="slider-val" id="flyspeed-val">50</div>
        </div>
        <input type="range" class="slider" id="fly-slider" min="10" max="200" value="50"
          oninput="updateSlider(this, 'flyspeed-val')">
      </div>

      <div class="slider-row">
        <div class="slider-header">
          <div class="slider-label">🏃 Tốc độ chạy</div>
          <div class="slider-val" id="speed-val">16</div>
        </div>
        <input type="range" class="slider" id="speed-slider" min="16" max="150" value="16"
          oninput="updateSlider(this, 'speed-val')">
      </div>
    </div>

    <!-- MISC TAB -->
    <div class="content" id="tab-misc" style="display:none">
      <div class="section-label">Tiện Ích</div>

      <div class="feature-row" onclick="toggleFeature(this, 'ESP đã BẬT')">
        <div class="feat-icon">👁️</div>
        <div class="feat-info">
          <div class="feat-name">ESP / Wallhack</div>
          <div class="feat-desc">Nhìn thấy zombie qua tường</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>

      <div class="feature-row" onclick="toggleFeature(this, 'Auto Farm đã BẬT')">
        <div class="feat-icon">🤖</div>
        <div class="feat-info">
          <div class="feat-name">Auto Farm</div>
          <div class="feat-desc">Tự động farm tiền và điểm</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>

      <div class="feature-row" onclick="toggleFeature(this, 'Infinite Ammo đã BẬT')">
        <div class="feat-icon">🔫</div>
        <div class="feat-info">
          <div class="feat-name">Infinite Ammo</div>
          <div class="feat-desc">Đạn vô hạn, không cần reload</div>
        </div>
        <div class="toggle"><div class="toggle-knob"></div></div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-info">v2.4 · <span>RUBU</span> · by dev</div>
      <button class="inject-btn">▶ APPLY</button>
    </div>

  </div>
</div>

<script>
  function toggleFeature(row, msg) {
    row.classList.toggle('on');
    const toggle = row.querySelector('.toggle');
    toggle.classList.toggle('on');
    showNotif(msg);
  }

  function showNotif(msg) {
    const n = document.getElementById('notif');
    n.textContent = '✓ ' + msg;
    n.classList.add('show');
    setTimeout(() => n.classList.remove('show'), 2000);
  }

  function switchTab(btn, tabId) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    ['combat', 'move', 'misc'].forEach(id => {
      document.getElementById('tab-' + id).style.display = id === tabId ? 'flex' : 'none';
    });
  }

  function updateSlider(el, valId) {
    document.getElementById(valId).textContent = el.value;
    const pct = (el.value - el.min) / (el.max - el.min) * 100;
    el.style.background = `linear-gradient(90deg, var(--neon-green) ${pct}%, #222 ${pct}%)`;
  }
</script>
</body>
</html>
